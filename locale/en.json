{
	"database": "PostgreSQL",
	"wildcard-error": {
		"i": "wildcard ~[$i] must be of type non-null ~{object}, ~[value] {{-type,valueType}}",
		"r": "wildcard ~[$r] must be one of type ~{string} or an instance of ~{Array}, ~[value] {{-type,valueType}}",
		"$": "wildcard ~[$$] must be of type ~{string}, ~[value] {{-type,valueType}}",
		"unknown": "unknown ~[wildcard], ~[value] {{-type,valueType}}"
	},
	"position": "position {{index,value}}",
	"connect-database": "connect ~[database] {{name,value}}",
	"connect-database-info": "✔ ~[user] {{user,value}} ~[client encoding] {{encoding,value}}",
	"disconnect-database": "disconnect ~[database] {{name,value}}",
	"disconnect-database-info": "✔ ~[user] {{user,value}}",
	"rollback-error": "rollback failed. ~[rollback error]{{errorRollback,value}}. ~[rollback reason]{{error,value}}"
}
